    "numeric_mediation_claim": true
  },
  "factorial": {
    "factors": {
      "feedback": [
        "off",
        "on"
      ],
      "granularity": [
        "utterance",
        "session"
      ]
    },
    "arms": [
      {
        "feedback": "off",
        "granularity": "utterance"
      },
      {
        "feedback": "off",
        "granularity": "session"
      },
      {
        "feedback": "on",
        "granularity": "utterance"
      },
      {
        "feedback": "on",
        "granularity": "session"
      }
    ],
    "interaction_contrasts": [
      "feedback by granularity difference-in-differences"
    ],
    "preregistered": true,
    "selection_basis": [
      "interaction",
      "main_effects"
    ]
  },
  "randomization": {
    "fixed": false,
    "algorithm_version": "example-policy-v1",
    "clipping": {
      "lower": 0.1,
      "upper": 0.9
    },
    "actual_probability_logged": true,
    "fixed_probability_assumed": false
