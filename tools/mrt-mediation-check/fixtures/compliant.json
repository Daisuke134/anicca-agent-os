{
  "design": {
    "treatment_type": "factorial",
    "outcomes": {
      "proximal_types": [
        "engagement",
        "target_behavior"
      ],
      "distal_present": true
    }
  },
  "distal_claim": true,
  "distal_effects": [
    "direct",
    "indirect",
    "total"
  ],
  "mediation_claim": true,
  "mediator": {
    "definition": "practice confidence",
    "measurement_time": "immediately after each treatment",
    "nearest_after_treatment": true
  },
  "estimands": {
    "direct": "natural direct excursion effect",
    "indirect": "natural indirect excursion effect",
    "total": "total excursion effect"
  },
  "identification_assumptions": [
    "consistency",
    "positivity",
    "sequential ignorability"
  ],
  "estimator": {
    "robustness": "doubly_robust",
