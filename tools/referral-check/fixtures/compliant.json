{
 "app": "Anicca-compliant-design",
 "referral_program_implemented": true,
 "reward": {
  "referrer_type": "premium_days",
  "referee_type": "premium_days",
  "referrer_value_days": 7,
  "referee_value_days": 7,
  "referrer_cap_days": 30
 },
 "ask": {
  "trigger": "after_first_affirmation_complete",
  "placements": [
   "after_value_screen",
   "profile"
  ],
  "share_content_has_standalone_value": true,
  "share_taps": 2
 },
 "completion": {
  "event": "referee_activation",
  "idempotent_per_pair": true
 },
 "attribution": {
  "code_origin": "server",
  "code_delivery": "typed_code",
  "subscriber_attribute_set_before_purchase": true,
  "first_attribution_wins": true
 },
 "fraud": {
  "hold_days": 7,
  "manual_claim": false,
  "self_referral_check": true
 },
 "measurement": {
  "metrics": [
   "k_factor",
   "invite_to_activation",
   "share_rate",
   "cycle_time"
  ],
  "denominator": "eligible",
  "compares_to_paid_cac": true
 },
 "k_honesty": {
  "i_counts": "sends_left_app",
  "c_counts": "activated",
  "window_days": 30,
  "invites_shares_tagged_separately": true,
  "k_gt1_treated_as_timestamp": true
 },
 "cycle": {
  "cycle_time_measured": true,
  "cycle_time_days": 9,
  "loop_efficiency_measured": true,
  "k_by_cohort": true
 },
 "pool": {
  "model": "pre_generated_pool",
  "statuses": [
   "available",
   "pending",
   "used",
   "expired"
  ],
  "refill_scheduled": true,
  "refill_threshold_defined": true,
  "detection_paths": [
   "revenuecat_webhook",
   "ios_confirm_endpoint"
  ],
  "webhook_auth_validated": true,
  "single_entitlement_id": true,
  "self_referral_rejected_at_redemption": true
 },
 "economics": {
  "effective_cac_formula": "paid_cac_x_1_minus_k",
  "referral_cost_per_activation_tracked": true
 }
}